# Supabase (Project Settings -> API). Service role key is server-only; never expose it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co   # NEXT_PUBLIC_SUPABASE_URL also works
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (dash.cloudflare.com -> Turnstile). These defaults are Cloudflare's
# always-pass test keys; replace them with real keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Admin portal login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=
