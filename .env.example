# Supabase. Optional: the app defaults to the campus-leader-signups project.
# The publishable key is safe to expose; the table is only reachable via RPC functions.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co   # NEXT_PUBLIC_SUPABASE_URL also works
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...     # NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY also works

# Admin portal login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`).
# Also used as the database admin token: its SHA-256 must be stored in private.app_config
# (see supabase/migrations/0002_rpc_access.sql).
ADMIN_SESSION_SECRET=
